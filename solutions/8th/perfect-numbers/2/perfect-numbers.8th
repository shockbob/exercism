{-1:"deficient",0:"perfect",1:"abundant"} constant eval

: factors >r a:new 1 a:push
      ( dup r@ swap n:/mod swap 
          0 n:= if -rot a:push swap a:push 
           else 
              2drop 
          then )
      2 r@ n:sqrt n:round n:int loop
     ( n:= ) a:uniq ;
     
: classify \ n -- s
 dup 1 n:= if
    drop
     eval -1 m:@ nip
  else
     dup 0 n:> if
         dup factors ( n:+ ) 0 a:reduce swap n:cmp eval swap m:@ nip
      else 
         drop
         null
      then
 then ;