: get2next \ n a -- s s
    swap dup n:1+ rot swap a:@ -rot swap a:@ nip 
;

: recite \ a -- a
    a:len 0 = if ;then
    a:len 1 = if 
       0 a:@ 
       "And all for the want of a " 
       swap s:+
       "." s:+ 
       a:new a:push
       nip
   ;then
   >r a:new ( r@ get2next  "For want of a " swap s:+ " the " s:+ swap s:+ " was lost." s:+ a:push  ) 0 r@ a:len nip 2 n:- loop 
    r@ 0 1 a:slice recite a:+
;
