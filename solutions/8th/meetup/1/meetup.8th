{"Monday":1,"Tuesday":2,"Wednesday":3,"Thursday":4,"Friday":5,"Saturday":6,"Sunday":7} constant
  day-map

{"first": 0, "second":1, "third":2,"fourth":3,"last":-1 } constant which-week-map

: get-day-of-week-number 
    "%u" d:format >n
;

: first-teenth \ d -- n
     12 d:+ get-day-of-week-number  
;

: days-to-add \ n n - n
    n:- dup 0 n:< if 7 n:+ then
;

: first-teenth-day \ n d - d
    tuck first-teenth days-to-add 12 n:+ d:+
;

: date-filter \ a d -- a
    d:mdays nip swap ( over n:> not ) a:filter nip ;

: five-weeks \ n -- a
   ( dup 7 n:+ ) 4 times 5 a:close 
;
: days \ n d -- a
    2dup get-day-of-week-number days-to-add 1 n:+ five-weeks swap date-filter nip
;

: which-week-calculate \ n -- d
   which-week-map swap m:_@ >r 
   tuck days r@ a:_@ n:1- d:+ rdrop
;

: meetup \ n n s s -- d
     >r
    day-map swap m:_@ 
    -rot 1 3 a:close d:join 
    r@ "teenth" s:= if first-teenth-day ;then
    r@ which-week-calculate
    rdrop
;  