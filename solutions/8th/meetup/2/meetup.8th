needs date/utils
 
{"Monday":1,"Tuesday":2,"Wednesday":3,"Thursday":4,"Friday":5,"Saturday":6,"Sunday":7} constant
  day-map

{"first": 0, "second":1, "third":2,"fourth":3,"last":-1 } constant which-week-map

: date-filter \ a d -- a
    d:mdays nip swap ( over n:> not ) a:filter nip ;

: five-weeks \ n -- a
    d:/ 2 a:_@ ( dup 7 d:+ ) 4 times 5 a:close 
;
: days \ n d -- a
    swap tuck d:first-dow dup five-weeks swap date-filter nip
;

: first-teenth-day \ n d - d
    tuck days ( 13 19 n:between ) a:filter 0 a:_@  n:1- d:+ 
;

: which-week-calculate \ n -- d
   which-week-map swap m:_@ >r 
   tuck days r@ a:_@ n:1- d:+ rdrop
;

: meetup \ n n s s -- d
     >r
    day-map swap m:_@ 
    -rot 1 0 0 0 6 a:close d:join 
    r@ "teenth" s:= if first-teenth-day ;then
    r@ which-week-calculate
    rdrop
;  